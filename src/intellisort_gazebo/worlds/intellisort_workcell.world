<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="intellisort_workcell">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.65 0.72 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Colored workpieces as free bodies on the table -->
    <model name="part_red">
      <pose>0.38 -0.18 0.77 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.85 0.12 0.12 1</ambient>
            <diffuse>0.85 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="part_green">
      <pose>0.30 -0.12 0.77 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.014</radius><length>0.04</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.014</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.72 0.28 1</ambient>
            <diffuse>0.12 0.72 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="part_blue">
      <pose>0.42 -0.08 0.77 0 0 -0.2</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.032 0.032 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.032 0.032 0.03</size></box></geometry>
          <material>
            <ambient>0.12 0.28 0.85 1</ambient>
            <diffuse>0.12 0.28 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="part_yellow">
      <pose>0.32 -0.20 0.77 0 0 0.5</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.028 0.028 0.028</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.028 0.028 0.028</size></box></geometry>
          <material>
            <ambient>0.92 0.78 0.12 1</ambient>
            <diffuse>0.92 0.78 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Floor light -->
    <light type="directional" name="key_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

  </world>
</sdf>
