<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic robot description for MoveIt2 -->
<robot name="isc_arm">

  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="joint5"/>
    <joint name="joint6"/>
  </group>

  <group name="gripper">
    <joint name="gripper_left_joint"/>
    <joint name="gripper_right_joint"/>
  </group>

  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="-0.6"/>
    <joint name="joint3" value="1.1"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0.8"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_left_joint" value="0.035"/>
    <joint name="gripper_right_joint" value="0.035"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_left_joint" value="0.0"/>
    <joint name="gripper_right_joint" value="0.0"/>
  </group_state>

  <end_effector name="gripper_ee" parent_link="tool0" group="gripper" parent_group="arm"/>

  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_left_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_right_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Never"/>
  <disable_collisions link1="tcp_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="table_link" reason="Default"/>
  <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>

</robot>
